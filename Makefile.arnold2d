# Makefile for Arnold 2D H.264 DC Encryption

CXX = g++
CXXFLAGS = -std=c++17 -Wall -Wextra -O2
LDFLAGS =

# Targets
ENCRYPT = encrypt_arnold2d
DECRYPT = decrypt_arnold2d

# Object files
ARNOLD_OBJ = arnold_2d.o
METADATA_OBJ = dc_metadata.o

.PHONY: all clean help

all: $(ENCRYPT) $(DECRYPT)

%.o: %.cpp %.h
	$(CXX) $(CXXFLAGS) -c $< -o $@

$(ENCRYPT): $(ARNOLD_OBJ) $(METADATA_OBJ) encrypt_arnold2d.cpp
	$(CXX) $(CXXFLAGS) -o $@ $^ $(LDFLAGS)
	@echo "✅ Built: $@"

$(DECRYPT): $(ARNOLD_OBJ) $(METADATA_OBJ) decrypt_arnold2d.cpp
	$(CXX) $(CXXFLAGS) -o $@ $^ $(LDFLAGS)
	@echo "✅ Built: $@"

clean:
	rm -f *.o $(ENCRYPT) $(DECRYPT)
	@echo "✅ Cleaned"

help:
	@echo "Arnold 2D H.264 DC Encryption"
